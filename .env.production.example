POSTGRES_DB=project_bobo
POSTGRES_USER=project_bobo
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

# Compose 내부에서는 DB 호스트 이름으로 postgres를 사용한다.
DATABASE_URL=postgresql://project_bobo:replace-with-a-long-random-password@postgres:5432/project_bobo?schema=public

APP_PORT=3000
PUBG_API_KEY=replace-with-your-pubg-api-key
PUBG_CLAN_ID=replace-with-your-pubg-clan-id
# PUBG API가 반환하는 account.x 형식의 계정 ID다. 비워두면 마스터 카드를 표시하지 않는다.
PUBG_CLAN_MASTER_ID=account.replace-with-your-pubg-account-id
LOG_LEVEL=info
LOG_PRETTY=false

# 이 파일 자체가 아니라 토큰 한 줄이 들어 있는 파일 경로다.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token
