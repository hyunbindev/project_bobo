POSTGRES_DB=project_bobo
POSTGRES_USER=project_bobo
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

# Compose 내부에서는 DB 호스트 이름으로 postgres를 사용한다.
DATABASE_URL=postgresql://project_bobo:replace-with-a-long-random-password@postgres:5432/project_bobo?schema=public

APP_PORT=3000
APP_BASE_URL=https://www.boboclan.win
PUBG_API_KEY=replace-with-your-pubg-api-key
PUBG_CLAN_ID=replace-with-your-pubg-clan-id
# PUBG API가 반환하는 account.x 형식의 계정 ID다. 비워두면 마스터 카드를 표시하지 않는다.
PUBG_CLAN_MASTER_ID=account.replace-with-your-pubg-account-id
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token
# 등록 토큰용 32바이트 Base64 키. 실제 키를 생성해 서버에만 저장한다.
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 아래 값은 Compose 검증용 예시이며 운영에서 그대로 사용하면 안 된다.
DISCORD_REGISTRATION_ENCRYPTION_KEY=replace-with-your-registration-encryption-key
DISCORD_APPLICATION_ID=replace-with-your-discord-application-id
DISCORD_GUILD_ID=replace-with-your-discord-guild-id
LOG_LEVEL=info
LOG_PRETTY=false
LOG_WEB_ENABLED=true
LOG_SCHEDULER_ENABLED=true
LOG_DISCORD_ENABLED=true

# 이 파일 자체가 아니라 토큰 한 줄이 들어 있는 파일 경로다.
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token

# 관제도 동일 프로젝트에서 실행한다. 실제 비밀번호를 지정해야 Compose 검증이 통과한다.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://127.0.0.1:3001
# Tunnel 서비스 주소: http://manage:3000

