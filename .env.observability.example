# Copy to .env.observability on the server. Do not commit the real file.
GRAFANA_ADMIN_USER=admin
# Required: set a unique password before starting the stack.
GRAFANA_ADMIN_PASSWORD=

# Default access: SSH port forwarding to http://127.0.0.1:3001.
# For LAN access, set this to the server's LAN IP address.
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://127.0.0.1:3001

# Existing network used by cloudflared. Start the app project first.
APP_FRONTEND_NETWORK=project-bobo_bobo_frontend
# For Tunnel access, set GRAFANA_ROOT_URL to your public HTTPS URL.
# Tunnel service URL: http://bobo-grafana:3000

# Docker Compose project label of the existing app, not a container ID.
TARGET_COMPOSE_PROJECT=project-bobo
