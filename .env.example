POSTGRES_DB=project_bobo
POSTGRES_USER=project_bobo
POSTGRES_PASSWORD=project_bobo_local
POSTGRES_PORT=5433
DATABASE_URL=postgresql://project_bobo:project_bobo_local@127.0.0.1:5433/project_bobo?schema=public
APP_BASE_URL=http://localhost:3000
PUBG_API_KEY=
PUBG_CLAN_ID=
# PUBG account ID (account....), used to initialize an empty database.
PUBG_CLAN_MASTER_ID=
DISCORD_BOT_TOKEN=
# 등록 토큰용 32바이트 Base64 키. 한 번 생성한 값을 계속 유지한다.
# 생성: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DISCORD_REGISTRATION_ENCRYPTION_KEY=
DISCORD_APPLICATION_ID=
# 치킨 자동 알림을 받을 Discord 서버 ID다. 입장 DM은 이벤트의 서버 ID를 사용한다.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=
LOG_LEVEL=info
LOG_PRETTY=true
LOG_WEB_ENABLED=true
LOG_SCHEDULER_ENABLED=true
LOG_DISCORD_ENABLED=true

# PostHog Cloud: leave the project token empty to disable capture locally.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
