logging {
  level  = "info"
  format = "json"
}

// Collect this Compose project. Exclude the collectors to avoid collecting their own logs.
discovery.docker "bobo" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"

  filter {
    name   = "label"
    values = ["com.docker.compose.project=" + sys.env("TARGET_COMPOSE_PROJECT")]
  }
}

discovery.relabel "bobo" {
  targets = discovery.docker.bobo.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(loki|alloy|grafana)"
    action        = "drop"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "bobo" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.bobo.output
  labels        = {}
  relabel_rules = discovery.relabel.bobo.rules
  forward_to    = [loki.process.bobo.receiver]
}

loki.process "bobo" {
  // Loki accepts 168h. Leave a margin so replaying old Docker logs cannot poison batches.
  stage.drop {
    older_than          = "167h"
    drop_counter_reason = "outside_loki_retention"
  }

  stage.match {
    selector = "{service_name=\"app\"}"

    stage.decolorize {}

    // Join legacy pretty fields and indented stack traces; each JSON record starts a new entry.
    stage.multiline {
      firstline     = "^\\S"
      max_wait_time = "2s"
      max_lines     = 256
    }

    stage.regex {
      expression = "^(?P<level>TRACE|DEBUG|INFO|WARN|ERROR|FATAL) \\["
    }
    stage.regex {
      expression = `(?m)^\s+logCategory: "(?P<category>web|scheduler|discord)"`
    }
    stage.json {
      expressions = {
        category = "logCategory",
        level    = "level",
      }
      drop_malformed = false
    }
    stage.template {
      source   = "level"
      template = "{{ if eq .Value \"10\" }}trace{{ else if eq .Value \"20\" }}debug{{ else if eq .Value \"30\" }}info{{ else if eq .Value \"40\" }}warn{{ else if eq .Value \"50\" }}error{{ else if eq .Value \"60\" }}fatal{{ else if .Value }}{{ ToLower .Value }}{{ else }}unknown{{ end }}"
    }
    stage.labels {
      values = {
        category = "",
        severity = "level",
      }
    }
  }

  // requestId, runId, playerId and matchId stay in the log body.
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
