{
  "uid": "bobo-logs",
  "title": "BOBO 운영 로그",
  "description": "Docker → Alloy → Loki. 카테고리/등급별 검색과 동기화·Discord 운영 현황. 로그 기반 지표이며 HTTP 요청 계측은 포함하지 않습니다.",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": [
    "bobo",
    "logs",
    "operations"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "project",
        "label": "프로젝트",
        "type": "textbox",
        "query": "project-bobo",
        "current": {
          "text": "project-bobo",
          "value": "project-bobo"
        }
      },
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "bobo-loki"
        },
        "query": "label_values({project=\"$project\"}, service_name)",
        "definition": "label_values({project=\"$project\"}, service_name)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "category",
        "label": "카테고리",
        "type": "custom",
        "query": "web,scheduler,discord",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "severity",
        "label": "등급",
        "type": "custom",
        "query": "trace,debug,info,warn,error,fatal,unknown",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "search",
        "label": "로그 검색 (정규식)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "수집된 로그",
      "type": "stat",
      "description": "선택한 시간·서비스·카테고리·등급에 해당하는 수집 로그 행 수입니다. HTTP 요청 수가 아닙니다.",
      "datasource": {
        "type": "loki",
        "uid": "bobo-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "bobo-loki"
          },
          "expr": "sum(count_over_time({project=\"$project\", service_name=~\"$service\", category=~\"$category\", severity=~\"$severity\"}[$__range])) or vector(0)",
          "queryType": "instant",
          "legendFormat": "{{service_name}} {{category}} {{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
