      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "bobo-loki"
          },
          "expr": "avg(avg_over_time({project=\"$project\", service_name=\"app\", category=~\"$category\", severity=~\"$severity\"} | json | __error__=\"\" | event=\"match_sync.completed\" | unwrap durationMs | __error__=\"\" [5m]))",
